# Supabase → Project Settings → API. Both are public by design (RLS protects data).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Push notifications (see docs/PUSH-SETUP.md). Generate with: bunx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Same random value as the Vault secret mypaddie_push_secret (openssl rand -hex 32)
PUSH_CRON_SECRET=
